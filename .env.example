MORPHOSIS_HOST=127.0.0.1
MORPHOSIS_PORT=8765
MORPHOSIS_DB=morphosis.sqlite
MORPHOSIS_LOG_LEVEL=info
MORPHOSIS_REQUEST_MAX_BYTES=131072
MORPHOSIS_SSE_HEARTBEAT_SECONDS=10
MORPHOSIS_SEED_REFERENCE=false
MORPHOSIS_DISABLE_DOCS=false
# Comma-separated explicit origins. Wildcards are intentionally rejected.
MORPHOSIS_ALLOWED_ORIGINS=

# Optional operator-owned JSON file that binds exact provider+endpoint pairs.
# MORPHOSIS_TRANSPORTS_FILE=/run/secrets/morphosis-transports.json

# Optional read-only Amazon Bedrock control-plane discovery.
# AWS credentials/IAM remain host-owned; discovered catalog metadata stays UNVERIFIED.
MORPHOSIS_BEDROCK_DISCOVERY=false
# MORPHOSIS_AWS_REGION=us-east-1

# Optional operator-owned canonical Evolution OS workload contract.
# The public command API cannot modify this policy.
# MORPHOSIS_CONTRACT_FILE=/etc/morphosis/workload-contract.json

# Optional real request shadow/canary/ramp gating. Disabled by default.
# When disabled, SHADOW/CANARY/RAMP remain deterministic deployment checks only.
MORPHOSIS_LIVE_TRAFFIC=false
# Mark samples as production traffic only when these are truly production requests.
MORPHOSIS_LIVE_TRAFFIC_PRODUCTION=false
MORPHOSIS_CANARY_FRACTION=0.05
MORPHOSIS_RAMP_FRACTION=0.25
MORPHOSIS_MIN_SHADOW_SAMPLES=20
MORPHOSIS_MIN_CANARY_SAMPLES=20
MORPHOSIS_MIN_RAMP_SAMPLES=20
MORPHOSIS_MAX_TRAFFIC_MISMATCH_RATE=0.0
